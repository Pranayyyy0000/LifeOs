# OPENROUTER_API_KEY: Tertiary fallback provider (Optional)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
PORT=3000
