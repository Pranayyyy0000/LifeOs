# GEMINI_API_KEY: Primary AI provider (Required in AI Studio Secrets)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# GROQ_API_KEY: Secondary fallback provider (Optional)
GROQ_API_KEY=""
